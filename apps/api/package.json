{
  "name": "@org-code-ai/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "prebuild": "cd apps/api && prisma generate || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@octokit/graphql": "^7.0.0",
    "@octokit/rest": "^20.0.0",
    "@org-code-ai/ai-agents": "*",
    "@org-code-ai/graphql-client": "*",
    "@org-code-ai/types": "*",
    "@prisma/client": "^7.2.0",
    "bullmq": "^5.66.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "ioredis": "^5.8.2",
    "openai": "^4.0.0",
    "pg": "^8.11.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.7",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "latest"
  }
}
